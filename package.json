{
  "name": "epoch",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && mkdir -p dist/attached_assets dist/public && ( [ -d attached_assets ] && cp -r attached_assets dist/attached_assets || true ) && ( [ -f client/public/logo_updated.png ] && cp client/public/logo_updated.png dist/public/logo_updated.png || true )",
    "start": "NODE_ENV=production tsx server/index.ts",
    "start:with-db-maintenance": "RUN_STARTUP_DB_MAINTENANCE=true tsx server/index.ts",
    "deploy": "npm run predb:push && npm run build",
    "check": "tsc",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0 && node scripts/check-format-dates.js",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:dates": "node scripts/check-format-dates.js",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "backfill:p2-packets": "tsx server/scripts/backfillP2UsedPackets.ts",
    "maintenance:backfill-stuck-p2-items": "tsx server/scripts/backfillStuckP2SerializedItems.ts",
    "maintenance:boot-repairs": "tsx server/scripts/maintenance/runBootRepairs.ts",
    "maintenance:historical-data-corrections": "tsx server/scripts/maintenance/runHistoricalDataCorrections.ts",
    "maintenance:safe-migrations": "tsx server/scripts/migrations/runSafeBootMigrations.ts",
    "repair:vendor-email-contacts": "tsx server/scripts/repairVendorEmailTemplateContacts.ts",
    "repair:p2-invoice-links": "tsx server/scripts/repairP2PackingSlipInvoiceLinks.ts",
    "trace:ar-invoice-number": "tsx server/scripts/traceArInvoiceNumber.ts",
    "timekeeping:import-timetrakgo-pdf": "tsx server/scripts/importTimeTrakGoTimeCardPdf.ts",
    "predb:push": "npx tsx server/pre-deploy-migrate.ts",
    "db:push": "drizzle-kit push",
    "prepare": "husky || true",
    "generate:audit-pdf": "node scripts/generate-audit-pdf.cjs"
  },
  "config": {
    "script-shell": "bash"
  },
