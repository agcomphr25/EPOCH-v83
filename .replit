modules = ["nodejs-20", "web", "bash", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"
packages = ["jq", "postgresql", "cairo", "pango", "libjpeg", "giflib", "librsvg", "pixman", "gh", "pkg-config", "libpng", "util-linux", "expect"]

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "deploy"]
migrate = ["true"]

[env]
#PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-client"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migration-safety"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "test-client"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run --config vitest.config.client.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "migration-safety"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run --config vitest.config.server.ts server/__tests__/migrationSafety.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80



[userenv]

[userenv.shared]
ACCEPT_BLUE_ENVIRONMENT = "production"
JWT_SECRET = "3adbfd669c7ffae02a7e7493342fc37e1115d182d8ef3ba7874d0a73c0f830814caac3a972cdc39dd185451fe355d6e2c28a81dfe0475d69d98dec1023f71a61"
JWT_TOKEN = "3adbfd669c7ffae02a7e7493342fc37e1115d182d8ef3ba7874d0a73c0f830814caac3a972cdc39dd185451fe355d6e2c28a81dfe0475d69d98dec1023f71a61"
PORTAL_JWT_SECRET = "3adbfd669c7ffae02a7e7493342fc37e1115d182d8ef3ba7874d0a73c0f830814caac3a972cdc39dd185451fe355d6e2c28a81dfe0475d69d98dec1023f71a61"
APP_URL = "https://agcompepoch.xyz"
PRODUCTION_DOMAIN = "agcompepoch.xyz"
PAUSE_ORDER_REMINDERS = "true"
UPS_ENV = "production"
PAUSE_ORDER_CONFIRMATION_EMAILS = "true"
ADDRESS_VALIDATION_ENABLED = "false"
OPENAI_API_KEY = "sk-placeholder"
AI_INTEGRATIONS_OPENAI_API_KEY = "sk-placeholder"

[userenv.development]
DEV_AUTH_BYPASS = "true"
FEATURE_WEBSITE_IMPORT = "true"
VITE_FEATURE_WEBSITE_IMPORT = "true"
PROTEUS_KEY_TIMECLOCK = "test-timeclock-key"
DEBUG_TRAVELER_ROUTING_FLOW = "development"

[userenv.production]

[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0", "javascript_openai_ai_integrations:2.0.0"]
stack = "FULLSTACK_JS"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
